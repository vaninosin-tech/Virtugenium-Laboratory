{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "virtugenium-lab",
  "version": "0.1.0",
  "identifier": "com.virtugenium.lab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Virtugenium Laboratory",
        "width": 1280,
        "height": 720,
        "resizable": true
      }
    ],
"security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}