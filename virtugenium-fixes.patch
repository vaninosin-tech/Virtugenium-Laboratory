+/** A point in the fume hood's own space, in the world, and the hood's yaw — from its live (calibrated) transform. */
+export function hoodLocalToWorld(local: Position3, out: THREE.Vector3): number {
+  const override = useFurniturePositionStore.getState().getOverride(HOOD.id);
+  const yaw = override.rotationY ?? HOOD.rotationY;
+  out.set(...local).applyAxisAngle(UP, yaw).add(new THREE.Vector3(...override.position));
+  return yaw;
+}
+
+/** The inverse: a world point as the hood's own (X, Y, Z) — for remembering where something was set down in it. */
